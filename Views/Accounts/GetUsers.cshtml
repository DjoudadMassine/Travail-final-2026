@model IEnumerable<Models.User>

<table class="table">
    <tr>
        <th>Nom</th>
        <th>Courriel</th>
        <th>Accès</th>
        <th>Vérifié</th>
        <th>Bloqué</th>
        <th>Actions</th>
    </tr>

    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Name</td>
            <td>@user.Email</td>
            <td>@user.Access</td>
            <td>@Helper.Checked(user.Verified)</td>
            <td>@Helper.Checked(user.Blocked)</td>
            <td>
                <i class="cmdIcon fa fa-eye setUserAccessCmd"
                   userId="@user.Id"
                   access="1"
                   title="Donner accès lecture"></i>

                <i class="cmdIcon fa fa-pen setUserAccessCmd"
                   userId="@user.Id"
                   access="2"
                   title="Donner accès écriture"></i>

                <i class="cmdIcon fa fa-crown setUserAccessCmd"
                   userId="@user.Id"
                   access="3"
                   title="Donner accès admin"></i>

                <i class="cmdIcon fa fa-ban blockCmd"
                   userId="@user.Id"
                   title="Bloquer/Débloquer"></i>

                <i class="cmdIcon fa fa-check forceVerifyCmd"
                   userId="@user.Id"
                   title="Forcer vérification"></i>

                <i class="cmdIcon fa fa-trash deleteCmd"
                   userId="@user.Id"
                   title="Supprimer"></i>
            </td>
        </tr>
    }
</table>