@model IEnumerable<Models.User>

<table class="table">
    <tr>
        <th>Nom</th>
        <th>Courriel</th>
        <th>Accès</th>
        <th>Vérifié</th>
        <th>Bloqué</th>
        <th>Actions</th>
    </tr>

    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Name</td>
            <td>@user.Email</td>
            <td>@user.Access</td>
            <td>@Helper.Checked(user.Verified)</td>
            <td>@Helper.Checked(user.Blocked)</td>
            <td>
                @if (user.Access != Models.Access.View)
                {
                    <i class="cmdIcon fa fa-eye setUserAccessCmd"
                       userId="@user.Id"
                       access="1"
                       title="Remettre en lecture seule"></i>
                }

                @if (user.Access != Models.Access.Write)
                {
                    <i class="cmdIcon fa fa-pen setUserAccessCmd"
                       userId="@user.Id"
                       access="2"
                       title="Donner droits d’écriture"></i>
                }
                else
                {
                    <i class="cmdIcon fa fa-pen-slash setUserAccessCmd"
                       userId="@user.Id"
                       access="1"
                       title="Enlever droits d’écriture"></i>
                }

                @if (user.Access != Models.Access.Admin)
                {
                    <i class="cmdIcon fa fa-crown setUserAccessCmd"
                       userId="@user.Id"
                       access="3"
                       title="Donner droits admin"></i>
                }
                else
                {
                    <i class="cmdIcon fa fa-user-minus setUserAccessCmd"
                       userId="@user.Id"
                       access="2"
                       title="Enlever droits admin"></i>
                }

                <i class="cmdIcon fa fa-ban blockCmd"
                   userId="@user.Id"
                   title="Bloquer/Débloquer"></i>

                <i class="cmdIcon fa fa-check forceVerifyCmd"
                   userId="@user.Id"
                   title="Forcer vérification"></i>

                <i class="cmdIcon fa fa-trash deleteCmd"
                   userId="@user.Id"
                   title="Supprimer"></i>
            </td>
        </tr>
    }
</table>