@model Models.Teacher

@{
    ViewBag.PageTitle = "Prof - Modification";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.Code)
    @Html.HiddenFor(m => m.Avatar)

    <fieldset>
        <legend>Informations</legend>

        <label>Prénom</label>
        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })

        <label>Nom</label>
        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })

        <label>Date d'embauche</label>
        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control datepicker" })

        <label>Téléphone</label>
        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control phoneExt" })

        <label>Avatar</label>
        <br />
        <img src="@Model.Avatar"
             style="width:350px; height:350px; object-fit:cover; border-radius:8px;" />
    </fieldset>

    <details open>
        <summary>Allocation : @Models.NextSession.Caption</summary>

        @Helper.SelectionLists(
            "selectedCoursesId",
            (System.Web.Mvc.SelectList)ViewBag.SelectedCourses,
            (System.Web.Mvc.SelectList)ViewBag.Courses
        )
    </details>
}
@section Scripts {
    <script>
        $(document).ready(function () {

            $(".AddSelection").off("click").on("click", function () {
                let parent = $(this).closest(".selectionsGrid");

                parent.find(".UnselectedItems option:selected").each(function () {
                    parent.find(".SelectedItems").append($(this));
                });
            });

            $(".RemoveSelection").off("click").on("click", function () {
                let parent = $(this).closest(".selectionsGrid");

                parent.find(".SelectedItems option:selected").each(function () {
                    parent.find(".UnselectedItems").append($(this));
                });
            });

            $(".UnselectAll").off("click").on("click", function () {
                let parent = $(this).closest(".selectionsGrid");

                parent.find("option").prop("selected", false);
            });

            $("form").on("submit", function () {
                $(".SelectedItems option").prop("selected", true);
            });
        });
    </script>
}