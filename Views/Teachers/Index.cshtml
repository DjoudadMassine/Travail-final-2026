@model IEnumerable<Models.Teacher>

<h2>Liste des enseignants</h2>

<p>
    @Html.ActionLink("Ajouter un enseignant", "Create")
</p>

<table class="table">
    <tr>
        <th>Code</th>
        <th>Nom</th>
        <th>Courriel</th>
        <th></th>
    </tr>

    @foreach (var teacher in Model)
    {
        <tr>
            <td>@teacher.Code</td>
            <td>@teacher.FullName</td>
            <td>@teacher.Email</td>
            <td>
                @Html.ActionLink("Détails", "Details", new { id = teacher.Id }) |
                @Html.ActionLink("Modifier", "Edit", new { id = teacher.Id }) |
                @Html.ActionLink("Supprimer", "Delete", new { id = teacher.Id })
            </td>
        </tr>
    }
</table>