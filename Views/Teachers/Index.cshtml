@model IEnumerable<Models.Teacher>

@{
    ViewBag.PageTitle = "Profs";
}

@foreach (var teacher in Model)
{
    <a href="@Url.Action("Details", "Teachers", new { id = teacher.Id })"
       class="TeacherLink">

        <div class="TeacherListLayout">

            <img src="@teacher.Avatar"
                 style="width:40px;
                        height:40px;
                        border-radius:50%;
                        object-fit:cover;" />

            <span class="teacherCode teacherSearchText">
                @teacher.Code
            </span>

            <span class="teacherSearchText">
                @teacher.LastName @teacher.FirstName
            </span>

        </div>

    </a>
}

@section Scripts {
    <script>

        function highlightTeachers() {

            let search = $("#searchInput").val();

            $(".teacherSearchText").each(function () {

                let original = $(this).data("original");

                if (!search) {
                    $(this).html(original);
                    return;
                }

                let safeSearch = search.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

                let regex = new RegExp("(" + safeSearch + ")", "gi");

                $(this).html(
                    original.replace(
                        regex,
                        "<span class='highlight'>$1</span>"
                    )
                );
            });
        }

        $(() => {

            $(".teacherSearchText").each(function () {
                $(this).data("original", $(this).html());
            });

            $("#searchInput").on("input", highlightTeachers);
        });

    </script>
}