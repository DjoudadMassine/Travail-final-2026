@model IEnumerable<Models.Teacher>

@{
    ViewBag.PageTitle = "Profs";
}

@foreach (var teacher in Model)
{
    <a href="@Url.Action("Details", "Teachers", new { id = teacher.Id })"
       class="TeacherLink">

        <div class="TeacherListLayout">

            <img src="@teacher.Avatar"
                 style="width:40px;
                        height:40px;
                        border-radius:50%;
                        object-fit:cover;" />

            <span class="teacherCode searchable">
                @teacher.Code
            </span>

            <span class="searchable">
                @teacher.LastName @teacher.FirstName
            </span>

        </div>

    </a>
}

@section Scripts {
    <script>

        function refreshTeacherHighlight() {

            let search = $("#searchInput").val();

            $(".searchable").each(function () {

                if ($(this).data("original") == null) {
                    $(this).data("original", $(this).html());
                }

                $(this).html($(this).data("original"));

                if (search && search.trim() !== "") {
                    highlight(search.toLowerCase(), this);
                }
            });
        }

        $(() => {

            $("#searchInput").on("input", function () {
                refreshTeacherHighlight();
            });

        });

    </script>
}