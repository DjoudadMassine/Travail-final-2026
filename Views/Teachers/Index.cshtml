@model IEnumerable<Models.Teacher>

@{
    ViewBag.PageTitle = "Profs";
}

<div id="teachersPanel">
    @Html.Partial("GetTeachers", Model)
</div>

@section Scripts {
    <script>

        function refreshTeacherHighlight() {

            let search = $("#searchInput").val().toLowerCase();

            $(".TeacherLink").each(function () {

                let row = $(this);

                let searchableText = row.text().toLowerCase();

                if (search.trim() === "" || searchableText.includes(search))
                    row.show();
                else
                    row.hide();

                row.find(".searchable").each(function () {

                    if ($(this).data("original") == null)
                        $(this).data("original", $(this).html());

                    $(this).html($(this).data("original"));

                    if (search.trim() !== "")
                        highlight(search, this);
                });
            });
        }

        $(() => {

            new AutoRefreshedPanel(
                "teachersPanel",
                "/Teachers/GetTeachers",
                5,
                function () {

                    $(".searchable").each(function () {
                        $(this).data("original", $(this).html());
                    });

                    refreshTeacherHighlight();
                });

            $("#searchInput").on("input", function () {
                refreshTeacherHighlight();
            });
        });

    </script>
}