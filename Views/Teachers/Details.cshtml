@model Models.Teacher

@{
    ViewBag.PageTitle = "Prof - Détails";
}

<div id="teacherDetailsPanel">
    @Html.Partial("GetTeacherDetails", Model)
</div>

@section Scripts {
    <script>
        $(() => {

            new AutoRefreshedPanel(
                "teacherDetailsPanel",
                "/Teachers/GetTeacherDetails/@Model.Id",
                5,
                function () {
                    RestoreDetailsState();
                });

        });
    </script>
}