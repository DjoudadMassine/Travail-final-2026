@{
    ViewBag.PageTitle = "Session courante";

    int year = ViewBag.Year;
    string season = ViewBag.Season;
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <details open>
        <summary>
            Choisissez l'année et la session pour les prochaines allocations de cours :
        </summary>

        <fieldset>
            <legend>Année</legend>

            <input type="number"
                   name="year"
                   value="@year"
                   class="form-control" />
        </fieldset>

        <fieldset>
            <legend>Session</legend>

            <label>
                <input type="radio"
                       name="season"
                       value="Automne"
                       @(season == "Automne" ? "checked" : "") />

                Automne
            </label>

            <br />

            <label>
                <input type="radio"
                       name="season"
                       value="Hiver"
                       @(season == "Hiver" ? "checked" : "") />

                Hiver
            </label>

        </fieldset>
    </details>
}