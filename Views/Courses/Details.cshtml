@model Models.Course

@{
    ViewBag.PageTitle = "Cours - Détails";
}

<div id="courseDetailsPanel">
    @Html.Partial("GetCourseDetails", Model)
</div>

@section Scripts {
    <script>
        $(() => {
            new AutoRefreshedPanel(
                "courseDetailsPanel",
                "/Courses/GetCourseDetails/@Model.Id",
                5,
                function () {
                    RestoreDetailsState();
                }
            );
        });
    </script>
}