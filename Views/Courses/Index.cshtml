@model IEnumerable<Models.Course>

@{
    ViewBag.PageTitle = "Cours";
    string search = ViewBag.Search != null ? ViewBag.Search.ToString() : "";
    var sessions = Model.Select(c => c.Session).Distinct().OrderBy(s => s).ToList();
}

@if (Session["Search"] != null && (bool)Session["Search"])
{
    <form method="get" action="@Url.Action("Index", "Courses")">
        <input type="text"
               name="search"
               value="@search"
               class="form-control"
               placeholder="Recherche..." />
    </form>
}

@foreach (var session in sessions)
{
    <details open id="course_details_@session">
        <summary>Session @session</summary>

        @foreach (var course in Model.Where(c => c.Session == session).OrderBy(c => c.Code))
        {
            <div class="CoursesListLayout">
                <a href="@Url.Action("Details", "Courses", new { id = course.Id })">
                    <span class="courseCode">@course.Code</span>
                    <span>
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            @Html.Raw(course.Title.Replace(search, "<span class='highlight'>" + search + "</span>"))
                        }
                        else
                        {
                            @course.Title
                        }
                    </span>
                </a>
            </div>
        }
    </details>
}

@section Scripts {
    <script>
        $(() => {
            RestoreDetailsState();
        });
    </script>
}