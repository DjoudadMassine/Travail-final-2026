@model IEnumerable<Models.Course>

@{
    ViewBag.PageTitle = "Cours";

    var sessions = Model
        .Select(c => c.Session)
        .Distinct()
        .OrderBy(s => s)
        .ToList();
}

@foreach (var session in sessions)
{
    <details open id="course_details_@session">

        <summary>
            Session @session
        </summary>

        @foreach (var course in Model
            .Where(c => c.Session == session)
            .OrderBy(c => c.Code))
        {
            <div class="CoursesListLayout">

                <a href="@Url.Action("Details", "Courses", new { id = course.Id })">

                    <span class="courseCode courseSearchText">
                        @course.Code
                    </span>

                    <span class="courseSearchText">
                        @course.Title
                    </span>

                </a>

            </div>
        }

    </details>
}

@section Scripts {
    <script>

        function refreshCourseHighlight() {

            let search = $("#searchInput").val().toLowerCase();

            $(".CoursesListLayout").each(function () {

                let row = $(this);

                let searchableText = row.text().toLowerCase();

                if (search.trim() === "" || searchableText.includes(search)) {
                    row.show();
                }
                else {
                    row.hide();
                }

                row.find(".courseSearchText").each(function () {

                    if ($(this).data("original") == null) {
                        $(this).data("original", $(this).html());
                    }

                    $(this).html($(this).data("original"));

                    if (search.trim() !== "") {
                        highlight(search, this);
                    }
                });
            });
        }

        $(() => {

            RestoreDetailsState();

            $("#searchInput").on("input", function () {
                refreshCourseHighlight();
            });

        });

    </script>
}