@model Models.Student

@{
    ViewBag.PageTitle = "Étudiant - Modification";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.Code)

    <details open>
        <summary>Informations - [@Model.Code]</summary>

        <label>Prénom</label>
        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })

        <label>Nom</label>
        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })

        <label>Date de naissance</label>
        @Html.TextBoxFor(m => m.BirthDate, "{0:yyyy-MM-dd}", new { @class = "form-control datepicker" })

        <label>Courriel</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })

        <label>Téléphone</label>
        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control phone" })
    </details>

    <details open>
        <summary>Inscriptions : @Models.NextSession.Caption</summary>

        @Helper.SelectionLists(
            "selectedCoursesId",
            (System.Web.Mvc.SelectList)ViewBag.Registrations,
            (System.Web.Mvc.SelectList)ViewBag.Courses
        )
    </details>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".AddSelection").off("click").on("click", function () {
                let parent = $(this).closest(".selectionsGrid");
                parent.find(".UnselectedItems option:selected").each(function () {
                    parent.find(".SelectedItems").append($(this));
                });
            });

            $(".RemoveSelection").off("click").on("click", function () {
                let parent = $(this).closest(".selectionsGrid");
                parent.find(".SelectedItems option:selected").each(function () {
                    parent.find(".UnselectedItems").append($(this));
                });
            });

            $("form").on("submit", function () {
                $(".SelectedItems option").prop("selected", true);
            });
        });
    </script>
}