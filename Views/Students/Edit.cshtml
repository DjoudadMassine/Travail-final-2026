@model Models.Student

@{
    ViewBag.Title = "Étudiant - Modification";
}

@using (Html.BeginForm("Edit", "Students", FormMethod.Post, new { id = "studentEditForm" }))
{
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.Code)

    <div class="editPageWhite">

        <div class="editPanelHeader">
            <span class="editIcon"></span>
            <h2>Étudiant - Modification</h2>
        </div>

        <div class="editSectionTitle">
            ▼ Informations - [@Model.Code]
        </div>

        <div class="editField">
            <label>Prénom</label>
            @Html.TextBoxFor(m => m.FirstName, new { @class = "editInput" })
        </div>

        <div class="editField">
            <label>Nom</label>
            @Html.TextBoxFor(m => m.LastName, new { @class = "editInput" })
        </div>

        <div class="editField">
            <label>Date de naissance</label>
            @Html.TextBoxFor(
                m => m.BirthDate,
                "{0:yyyy-MM-dd}",
                new { @class = "editInput", type = "date" }
            )
        </div>

        <div class="editField">
            <label>Courriel</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "editInput" })
        </div>

        <div class="editField">
            <label>Téléphone</label>
            @Html.TextBoxFor(m => m.Phone, new { @class = "editInput" })
        </div>

        <div class="editSectionTitle">
            ▼ Inscriptions : Session Automne 2026
        </div>

        <div class="dualListZone">

            <select multiple class="editList">
                @foreach (var course in ViewBag.StudentCourses)
                {
                    <option value="@course.Id">
                        [@course.Session] @course.Code @course.Title
                    </option>
                }
            </select>

            <select multiple class="editList" name="coursesToAdd">
                @foreach (var course in ViewBag.AvailableCourses)
                {
                    <option value="@course.Id">
                        [@course.Session] @course.Code @course.Title
                    </option>
                }
            </select>

        </div>

        <div class="infoBubble">
            Liste des cours offerts à l’automne
        </div>

    </div>

    <div class="sessionFooter">
        Session courante : Automne 2026
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const checkButton = document.querySelector(".fa-check, .fa-check-circle, .bi-check, .checkButton, .saveIcon");

        if (checkButton) {
            checkButton.addEventListener("click", function (event) {
                event.preventDefault();
                document.getElementById("studentEditForm").submit();
            });
        }
    });
</script>