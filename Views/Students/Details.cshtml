@model Models.Student

@{
    ViewBag.PageTitle = "Étudiant - Détails";
}

<div id="studentDetailsPanel">
    @Html.Partial("GetStudentDetails", Model)
</div>

@section Scripts {
    <script>
        $(() => {
            new AutoRefreshedPanel(
                "studentDetailsPanel",
                "/Students/GetStudentDetails/@Model.Id",
                5,
                function () {
                    RestoreDetailsState();
                });
        });
    </script>
}