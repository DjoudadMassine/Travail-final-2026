@model Models.Student

@{
    ViewBag.PageTitle = "Étudiant - Détails";

    var registrations = DAL.DB.Registrations.ToList()
        .Where(r => r.StudentId == Model.Id && r.Course != null)
        .OrderByDescending(r => r.Year)
        .ThenBy(r => r.Course.Session)
        .ThenBy(r => r.Course.Code)
        .ToList();

    var years = registrations
        .Select(r => r.Year)
        .Distinct()
        .OrderByDescending(y => y)
        .ToList();
}

<details open>
    <summary>
        <i class="fa fa-graduation-cap"></i>
        @Model.FirstName @Model.LastName
    </summary>

    <p><i class="fa fa-barcode"></i> @Model.Code</p>
    <p><i class="fa fa-phone"></i> @Model.Phone</p>
    <p><i class="fa fa-paper-plane"></i> @Model.Email</p>

    @if (Model.BirthDate.Year > 1900)
    {
        <p><i class="fa fa-cake-candles"></i> @Model.BirthDate.ToString("dd MMMM yyyy")</p>
    }
</details>

<hr />

<h3>Inscriptions</h3>

@foreach (var year in years)
{
    <details open id="student_details_@year">
        <summary>@year</summary>

        @foreach (var registration in registrations.Where(r => r.Year == year))
        {
            <div>
                [@registration.Course.Session]
                @Html.ActionLink(
                    registration.Course.Code + " " + registration.Course.Title,
                    "Details",
                    "Courses",
                    new { id = registration.Course.Id },
                    null
                )
            </div>
        }
    </details>
}