@model IEnumerable<Models.Student>

@{
    ViewBag.PageTitle = "Étudiants";
}

@{
    var years = Model
        .Select(s => s.Year)
        .Distinct()
        .OrderByDescending(y => y)
        .ToList();
}

@foreach (var year in years)
{
    <details open id="student_details_@year">

        <summary>
            Cohorte @year
        </summary>

        @foreach (var student in Model.Where(s => s.Year == year))
        {
            <div class="StudentListLayout"
                 onclick="window.location='@Url.Action("Details", "Students", new { id = student.Id })'">

                <div class="studentCode searchable">
                    @student.Code
                </div>

                <div class="searchable">
                    @student.FullName
                </div>

            </div>
        }

    </details>
}

@section Scripts {
    <script>

        function refreshStudentHighlight() {

            let search = $("#searchInput").val();

            $(".searchable").each(function () {

                if ($(this).data("original") == null) {
                    $(this).data("original", $(this).html());
                }

                $(this).html($(this).data("original"));

                if (search && search.trim() !== "") {
                    highlight(search.toLowerCase(), this);
                }
            });
        }

        $(() => {

            RestoreDetailsState();

            $("#searchInput").on("input", function () {
                refreshStudentHighlight();
            });

        });

    </script>
}