@model IEnumerable<Models.Student>

@{
    ViewBag.Title = "Étudiants";
}

<h2>Liste des étudiants</h2>

<p>
    @Html.ActionLink("Ajouter un étudiant", "Create")
</p>

<div>
    <div class="StudentListLayout">
        <div><strong>Code</strong></div>
        <div><strong>Nom</strong></div>
        <div><strong>Courriel</strong></div>
    </div>

    @foreach (var student in Model)
    {
        <div class="StudentListLayout"
             onclick="window.location='@Url.Action("Details", "Students", new { id = student.Id })'">

            <div class="studentCode">@student.Code</div>

            <div>@student.FullName</div>

            <div>@student.Email</div>

        </div>
    }
</div>