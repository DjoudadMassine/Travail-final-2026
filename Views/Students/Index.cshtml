@model IEnumerable<Models.Student>

@{
    ViewBag.PageTitle = "Étudiants";
}

@{
    var years = Model
        .Select(s => s.Year)
        .Distinct()
        .OrderByDescending(y => y)
        .ToList();
}

@foreach (var year in years)
{
    <details open id="student_details_@year">

        <summary>
            Cohorte @year
        </summary>

        @foreach (var student in Model.Where(s => s.Year == year))
        {
            <div class="StudentListLayout"
                 onclick="window.location='@Url.Action("Details", "Students", new { id = student.Id })'">

                <div class="studentCode studentSearchText">
                    @student.Code
                </div>

                <div class="studentSearchText">
                    @student.FullName
                </div>

            </div>
        }

    </details>
}

@section Scripts {
    <script>
        function highlightStudents() {

            let search = $("#searchInput").val();

            $(".studentSearchText").each(function () {

                let original = $(this).data("original");

                if (!search) {
                    $(this).html(original);
                    return;
                }

                let safeSearch = search.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

                let regex = new RegExp("(" + safeSearch + ")", "gi");

                $(this).html(
                    original.replace(
                        regex,
                        "<span class='highlight'>$1</span>"
                    )
                );
            });
        }

        $(() => {

            RestoreDetailsState();

            $(".studentSearchText").each(function () {
                $(this).data("original", $(this).html());
            });

            $("#searchInput").on("input", highlightStudents);
        });
    </script>
}