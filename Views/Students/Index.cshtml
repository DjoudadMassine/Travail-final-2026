@model IEnumerable<Models.Student>

@{
    ViewBag.PageTitle = "Étudiants";
}

<div id="studentsPanel">
    @Html.Partial("GetStudents", Model)
</div>

@section Scripts {
    <script>
        function refreshStudentHighlight() {
            let search = $("#searchInput").val().toLowerCase();

            $(".StudentListLayout").each(function () {
                let row = $(this);
                let searchableText = row.text().toLowerCase();

                if (search.trim() === "" || searchableText.includes(search))
                    row.show();
                else
                    row.hide();

                row.find(".searchable").each(function () {
                    if ($(this).data("original") == null)
                        $(this).data("original", $(this).html());

                    $(this).html($(this).data("original"));

                    if (search.trim() !== "")
                        highlight(search, this);
                });
            });
        }

        $(() => {
            new AutoRefreshedPanel("studentsPanel", "/Students/GetStudents", 5, function () {
                RestoreDetailsState();

                $(".searchable").each(function () {
                    $(this).data("original", $(this).html());
                });

                refreshStudentHighlight();
            });

            $("#searchInput").on("input", function () {
                refreshStudentHighlight();
            });
        });
    </script>
}